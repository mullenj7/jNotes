      "name": "Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();\npm.environment.set('user', JSON.stringify(response.user));\npm.environment.set('userId', response.user.id)"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {
          "content-type": true
        }
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"jason\",\r\n    \"email\": \"jason.mullen189@gmail.com\",\r\n    \"password\": \"Jason123!\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api}}/auth/register",
          "host": [
            "{{api}}"
          ],
          "path": [
            "auth",
            "register"
          ]
